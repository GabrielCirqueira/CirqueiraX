# Configurações do Agente CirqueiraX
SERVER_URL=http://localhost:4010/api/v1/ingestao/print
AGENT_TOKEN=seu_token_aqui

# Linux nativo: ~/Pictures/Screenshots
# WSL vigiando pasta do Windows: /mnt/c/Users/SeuUsuario/Pictures/Screenshots
WATCH_DIR=~/Pictures/Screenshots

DEBOUNCE_SECONDS=3.0
STATE_FILE=~/.cirqueirax_enviados.json
LOG_LEVEL=INFO

# Modo PollingObserver para WSL DrvFs e compartilhamentos de rede
USE_POLLING=true
POLLING_INTERVAL=1.5

