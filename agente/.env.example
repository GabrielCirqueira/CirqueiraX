# Configurações do Agente CirqueiraX
SERVER_URL=http://localhost:8080/api/v1/ingestao/print
AGENT_TOKEN=seu_token_aqui

# Linux nativo: ~/Pictures/Screenshots
# WSL vigiando pasta do Windows: /mnt/c/Users/SeuUsuario/Pictures/Screenshots (ou C:\Users\SeuUsuario\Pictures\Screenshots)
WATCH_DIR=~/Pictures/Screenshots

DEBOUNCE_SECONDS=3.0
STATE_FILE=~/.cirqueirax_enviados.json
LOG_LEVEL=INFO

# Modo de monitoramento para WSL / montagens DrvFs (auto-ativado para caminhos /mnt/)
USE_POLLING=true
POLLING_INTERVAL=1.5

