# ──────────────────────────────────────────────────────────────────────────────
# Dockerfile.prod — imagem de produção do Catalyst Skeleton
#
# Contém: PHP-FPM + Nginx interno + Supervisord
# O container expõe HTTP na porta 80.
# O Nginx do host faz proxy_pass para a porta mapeada (ex: 127.0.0.1:8080:80).
#
# Build feito pelo devops/deploy.sh via docker compose build.
# Para build manual: docker build -f devops/php/Dockerfile.prod -t catalyst-prod .
# ──────────────────────────────────────────────────────────────────────────────

# --- Builder: instala dependências PHP sem pacotes de dev ---
FROM php:8.4-fpm-alpine AS builder

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

RUN apk add --no-cache \
    git bash libzip-dev icu-dev oniguruma-dev \
    && docker-php-ext-install pdo_mysql zip intl opcache

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --optimize-autoloader --no-interaction

COPY . .
RUN composer dump-autoload --optimize

# --- Frontend builder: compila assets Vite/React para public/build/ ---
FROM node:22-alpine AS frontend-builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npm run build

# --- Whisper builder: compila o whisper.cpp e baixa o modelo de transcrição ---
FROM php:8.4-fpm-alpine AS whisper-builder

ARG WHISPER_VERSAO=v1.7.6
ARG WHISPER_MODELO=ggml-small-q5_1.bin

RUN apk add --no-cache build-base cmake git curl \
    && git clone --depth 1 --branch "${WHISPER_VERSAO}" https://github.com/ggml-org/whisper.cpp /src/whisper \
    && cmake -S /src/whisper -B /src/whisper/build -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF \
         -DWHISPER_BUILD_SERVER=OFF -DGGML_NATIVE=ON -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /src/whisper/build -j"$(nproc)" --target whisper-cli \
    && mkdir -p /opt/whisper/modelos \
    && cp /src/whisper/build/bin/whisper-cli /opt/whisper/whisper-cli \
    && curl -fsSL -o "/opt/whisper/modelos/${WHISPER_MODELO}" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/${WHISPER_MODELO}"

# --- Imagem final de produção ---
FROM php:8.4-fpm-alpine

ARG YTMUSICAPI_VERSAO=1.12.3
RUN apk add --no-cache \
    bash libzip-dev icu-dev oniguruma-dev \
    nginx supervisor curl openssl netcat-openbsd tzdata python3 py3-pip yt-dlp ffmpeg poppler-utils \
    && cp /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime \
    && echo "America/Sao_Paulo" > /etc/timezone \
    && docker-php-ext-install pdo_mysql zip intl opcache \
    && pip install --break-system-packages edge-tts "ytmusicapi==${YTMUSICAPI_VERSAO}" \
    && mkdir -p /run/nginx /var/log/supervisor

ARG PIPER_VERSAO=1.8.0
ARG PIPER_ESPEAKBRIDGE_COMMIT=e34f0399ba81e4306508e4507d5315481186014c
RUN apk add --no-cache py3-onnxruntime espeak-ng \
    && apk add --no-cache --virtual .piper-build build-base python3-dev espeak-ng-dev \
    && pip install --break-system-packages "piper-tts==${PIPER_VERSAO}" \
    && curl -fsSL -o /tmp/espeakbridge.c "https://raw.githubusercontent.com/OHF-Voice/piper1-gpl/${PIPER_ESPEAKBRIDGE_COMMIT}/src/piper/espeakbridge.c" \
    && PIPER_DIR="$(python3 -c 'import os, piper; print(os.path.dirname(piper.__file__))')" \
    && gcc -shared -fPIC -O2 $(python3-config --includes) /tmp/espeakbridge.c -lespeak-ng -o "${PIPER_DIR}/espeakbridge$(python3-config --extension-suffix)" \
    && rm -f /tmp/espeakbridge.c \
    && apk del .piper-build \
    && mkdir -p /opt/piper/vozes \
    && for voz in pt/pt_BR/faber/medium/pt_BR-faber-medium en/en_US/lessac/medium/en_US-lessac-medium; do \
         nome="$(basename "$voz")"; \
         curl -fsSL -o "/opt/piper/vozes/${nome}.onnx" "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/${voz}.onnx" \
         && curl -fsSL -o "/opt/piper/vozes/${nome}.onnx.json" "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/${voz}.onnx.json" \
         || exit 1; \
       done \
    && python3 -c "from piper import espeakbridge"

RUN apk add --no-cache libstdc++ libgomp
COPY --from=whisper-builder /opt/whisper /opt/whisper

WORKDIR /var/www/html

# Configurações PHP de produção
COPY devops/php/php.prod.ini /usr/local/etc/php/conf.d/php.ini

# Pool PHP-FPM: clear_env=no para que os workers herdem as variáveis do container
COPY devops/php/www.conf /usr/local/etc/php-fpm.d/www.conf

# Nginx interno: escuta na 80 e passa para php-fpm em 127.0.0.1:9000
COPY devops/php/nginx-internal.conf /etc/nginx/http.d/default.conf

# Supervisord: gerencia nginx + php-fpm como processos filhos
COPY devops/php/supervisord-prod.conf /etc/supervisord-prod.conf

# Copia a aplicação compilada pelo builder
COPY --from=builder --chown=www-data:www-data /app /var/www/html

# Copia os assets do frontend (Vite build → public/build/)
COPY --from=frontend-builder --chown=www-data:www-data /app/public/build /var/www/html/public/build

RUN mkdir -p /var/www/html/var/cache /var/www/html/var/log \
    && chown -R www-data:www-data /var/www/html/var

# bootstrap.sh roda antes do supervisord:
# gera JWT keys, aguarda DB, roda migrations, aquece cache
COPY --chmod=755 devops/bootstrap.sh /usr/local/bin/entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord-prod.conf"]
