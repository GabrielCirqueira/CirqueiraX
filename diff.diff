+        }
+
+        $token = $this->oAuthService->obterAccessTokenValido($conta);
+
+        $resultado = $this->googleFotosApi->criarAlbum($token, $categoria->nome());
+        $albumId = (string) ($resultado['id'] ?? '');
+
+        if ('' === $albumId) {
